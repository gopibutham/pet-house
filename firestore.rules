rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((request.auth.token.email == "gopibutham@gmail.com" && request.auth.token.email_verified == true) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
             data.uid is string &&
             data.email is string &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() < 100 &&
             data.role in ['admin', 'user'];
    }
    
    function isValidPet(data) {
      let requiredFields = ['name', 'species', 'breed', 'age', 'price', 'description', 'images', 'sellerId', 'sellerName', 'sellerEmail', 'location', 'status', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.species in ['Dog', 'Cat', 'Bird', 'Fish', 'Rabbit', 'Other'] &&
             data.price is number && data.price >= 0 &&
             data.images is list && data.images.size() > 0 &&
             (data.sellerId == request.auth.uid || isAdmin()) &&
             (!('isOfficial' in data) || (data.isOfficial is bool && (data.isOfficial == false || isAdmin()))) &&
             (!('stockCount' in data) || (data.stockCount is int && data.stockCount >= 0));
    }

    function isValidOrder(data) {
      let requiredFields = ['id', 'petId', 'petName', 'petImage', 'buyerId', 'buyerName', 'buyerEmail', 'price', 'status', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.buyerId == request.auth.uid &&
             data.status in ['pending', 'completed', 'cancelled'] &&
             data.price is number && data.price >= 0;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                      (request.resource.data.role == 'user' || isAdmin());
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && 
                       request.resource.data.role == resource.data.role) || isAdmin();
    }

    // Pet listings
    match /pets/{petId} {
      allow read: if isAuthenticated(); // Restricted to authenticated users
      allow create: if isAuthenticated() && isValidPet(request.resource.data);
      allow update: if isAdmin() || 
                       (isAuthenticated() && request.auth.uid == resource.data.sellerId && isValidPet(request.resource.data)) ||
                       (isAuthenticated() && resource.data.isOfficial == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockCount', 'updatedAt']));
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.sellerId);
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.buyerId == request.auth.uid);
      allow create: if isAuthenticated() && isValidOrder(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
